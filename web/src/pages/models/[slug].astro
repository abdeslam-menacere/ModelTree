---
import { ArrowLeft, CheckCircle2 } from 'lucide-react';
import ModelFit from '../../components/ModelFit';
import ModelPassport from '../../components/ModelPassport';
import SourceList from '../../components/SourceList.astro';
import UsageEvidence from '../../components/UsageEvidence';
import { dataset, releaseById, sourceById } from '../../data/dataset';
import type { SourceReference } from '../../data/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildModelFitGuidance } from '../../lib/model-fit';
import { buildModelPassport, type PassportSectionId } from '../../lib/passport';
import { organizationLabel } from '../../lib/organization-name';
import { modelStaticPaths } from '../../lib/routes';
import { absoluteUrl } from '../../lib/seo';
import { buildBreadcrumbJsonLd } from '../../lib/structured-data';
import { buildUsageEvidence } from '../../lib/usage-evidence';

export const getStaticPaths = modelStaticPaths;

interface Props {
  releaseId: string;
}

const { releaseId } = Astro.props;
const release = releaseById.get(releaseId);
if (!release) throw new Error(`Unknown release ${releaseId}`);

const base = import.meta.env.BASE_URL;
// The build date, so a figure verified long ago is marked stale in the output
// rather than depending on when the page is read.
const buildDate = new Date().toISOString().slice(0, 10);

const view = buildModelPassport(dataset, release.id, base, buildDate);
const usageEvidence = buildUsageEvidence(dataset, release.id, buildDate);
const fitGuidance = buildModelFitGuidance(dataset, release.id, buildDate);

// Section numbers are assigned over the sections that actually render, so the
// three components that own their own headings are told where they landed
// rather than each assuming a fixed position.
const sectionOf = (id: PassportSectionId) => {
  const section = view.sections.find((candidate) => candidate.id === id);
  if (!section) throw new Error(`Passport section ${id} is missing for ${release.id}`);
  return section;
};
const usageSection = sectionOf('usage');
const fitSection = sectionOf('fit');
const sourcesSection = sectionOf('sources');

const sources = release.sourceIds
  .map((sourceId) => sourceById.get(sourceId))
  .filter((source): source is SourceReference => Boolean(source));

const homeHref = `${base}#explorer`;
const catalogHref = `${base}models/`;

const origin = Astro.site?.origin ?? '';
const structuredData = [
  buildBreadcrumbJsonLd([
    { name: 'ModelTree', url: absoluteUrl(origin, base) },
    { name: 'Models', url: absoluteUrl(origin, `${base}models/`) },
    { name: view.displayName, url: absoluteUrl(origin, view.canonicalRoute) },
  ]),
];
---

<BaseLayout
  title={`${view.displayName} Model Passport | ModelTree`}
  description={`${view.displayName}: release identity, lineage, access, licensing, availability, pricing, evidence, and primary sources.`}
  passportHref={view.canonicalRoute}
  verifiedAt={view.verifiedAt}
  currentPage="passport"
  socialImageAlt={`${view.displayName} — Model Passport on ModelTree`}
  structuredData={structuredData}
>
  <main id="main-content" class="passport-page">
    <div class="passport-breadcrumbs">
      <a class="back-link" href={homeHref}><ArrowLeft size={17} aria-hidden="true" /> Back to lineage</a>
      <a class="back-link" href={catalogHref}>All models</a>
    </div>

    <header class="passport-hero">
      <div>
        <span class="eyebrow">Model Passport / {organizationLabel(view.organization)} / {view.family.name}</span>
        <h1>{view.displayName}</h1>
        <p>{view.summary}</p>
      </div>
      <div class="passport-stamp" aria-label={`Status: ${view.statusLabel}`}>
        <CheckCircle2 size={21} aria-hidden="true" />
        <span><strong>{view.statusLabel}</strong><small>Checked {view.verifiedAt}</small></span>
      </div>
    </header>

    <ModelPassport view={view} />

    <UsageEvidence
      evidence={usageEvidence}
      releaseName={view.displayName}
      headingId={usageSection.headingId}
      sectionNumber={usageSection.number ?? undefined}
    />

    <ModelFit
      guidance={fitGuidance}
      releaseName={view.displayName}
      headingId={fitSection.headingId}
      sectionNumber={fitSection.number ?? undefined}
    />

    <section class="passport-section sources-section" aria-labelledby={sourcesSection.headingId}>
      <div class="section-heading">
        <span class="section-number">{sourcesSection.number}</span>
        <div>
          <span class="eyebrow">{sourcesSection.eyebrow}</span>
          <h2 id={sourcesSection.headingId}>{sourcesSection.title}</h2>
        </div>
      </div>
      <SourceList sources={sources} />
      <p class="correction-note">
        Found something wrong on this page?
        <a href={view.correctionUrl}>Report incorrect data for {view.slug}</a>.
        Corrections are filed against the record slug so the fix lands on the right release.
      </p>
      <p class="verification-note">
        Every fact above is recorded with the primary source it came from and the date it was last
        checked. This record was last verified on {view.verifiedAt}.
      </p>
    </section>
  </main>
</BaseLayout>
