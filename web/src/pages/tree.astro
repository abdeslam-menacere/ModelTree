---
import ModelTreeExplorer from '../components/ModelTreeExplorer';
import { dataset, sourceById } from '../data/dataset';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/format';
import { buildModelTree, projectModelTree } from '../lib/model-tree';
import { buildReleaseSourceIndex } from '../lib/release-source';

// Projected, not whole: this becomes a serialised island prop, so it ships to
// every visitor. See `projectModelTree` (abdeslam-menacere/ModelTree#813).
const tree = projectModelTree(buildModelTree(dataset));
const sourceByReleaseId = buildReleaseSourceIndex(dataset.releases, sourceById);
const latestVerification = [...dataset.releases.map(({ verifiedAt }) => verifiedAt)].sort().at(-1)!;
const base = import.meta.env.BASE_URL;
const firstRelease = tree.featured[0]?.families[0]?.releases[0];
if (!firstRelease) throw new Error('Model Tree requires at least one featured ecosystem release');
---

<BaseLayout
	title="Model Tree | ModelTree"
	description="Explore editorially reviewed AI model ecosystems as a source-backed hierarchy of creators, families, and releases."
	passportHref={`${base}models/${firstRelease.slug}/`}
	verifiedAt={formatDate(latestVerification)}
	currentPage="tree"
	socialImageAlt="The ModelTree model tree — AI creators, families, and releases as a source-backed hierarchy."
>
	<main id="main-content" class="tree-page">
		<header class="tree-page-intro">
			<div>
				<span class="eyebrow">Semantic model lineage</span>
				<h1>Explore the Model Tree.</h1>
			</div>
			<div>
				<p>Follow reviewed ecosystems from creator to family to release. Featured placement is editorial and non-ranked: a creator is featured when it is one of the five this site leads with, which is a choice about where the site starts you rather than a measurement of the creators. A creator it omits keeps every release, its place under Others, and its own provider page.</p>
				<p class="tree-help">AI Model Ecosystem, Featured ecosystems, and Others start open. Expand any creator and family independently, then select a release.</p>
			</div>
		</header>
		<ModelTreeExplorer
			client:load
			tree={tree}
			sourceByReleaseId={sourceByReleaseId}
			basePath={base}
		/>
	</main>
</BaseLayout>
