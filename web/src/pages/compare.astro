---
import ModelComparison from '../components/ModelComparison';
import { dataset } from '../data/dataset';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildCatalogIndex } from '../lib/catalog';
import {
  buildComparisonPayload,
  MAX_COMPARISON_MODELS,
  MIN_COMPARISON_MODELS,
} from '../lib/comparison';
import { formatDate } from '../lib/format';

const base = import.meta.env.BASE_URL;
const index = buildCatalogIndex(dataset, base);

const firstModel = index.models[0];
if (!firstModel) throw new Error('Comparison requires at least one release');

// The site is built ahead of time, so which models to compare cannot be known
// here — 49 releases choose two to four is 211,876 pages. The records travel
// with the page instead, trimmed to the fields the table reads and budgeted by
// `measureComparisonPayload` so their weight stays visible. Fetching them at
// runtime is not an option this project allows.
const payload = buildComparisonPayload(dataset);

const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout
  title="Compare models | ModelTree"
  description="Compare two to four reviewed model releases side by side, with every value carrying its source and the date it was checked, and every gap named rather than hidden."
  passportHref={firstModel.route}
  verifiedAt={formatDate(index.latestVerifiedAt)}
  currentPage="compare"
  socialImageAlt="A ModelTree side-by-side comparison of reviewed AI model releases, every value sourced."
>
  <main id="main-content" class="compare-page">
    <header class="compare-intro">
      <div>
        <span class="eyebrow">Side by side</span>
        <h1>Compare {MIN_COMPARISON_MODELS} to {MAX_COMPARISON_MODELS} models.</h1>
      </div>
      <p>
        Every value shows the source it came from and the date that source was last checked. Where a
        fact is missing, the table says which kind of missing it is rather than leaving a blank.
        There is no overall winner here, and no score: the models are placed in the order you chose
        them, which is not a ranking.
      </p>
    </header>

    <ModelComparison
      client:load
      dataset={payload}
      initialSlugs={[]}
      base={base}
      today={today}
    />

    <noscript>
      <section class="compare-noscript">
        <h2>Every release, with its own page</h2>
        <p>
          A comparison is assembled in the browser from the address of this page. Without
          JavaScript, each release still has a static Model Passport carrying the same values, the
          same sources, and the same dates:
        </p>
        <ul>
          {index.models.map((model) => (
            <li>
              <a href={model.route}>{model.name}</a> — {model.organizationName} · {model.familyName}
            </li>
          ))}
        </ul>
      </section>
    </noscript>
  </main>
</BaseLayout>
