---
import HomepageSearch from '../components/HomepageSearch';
import LineageExplorer from '../components/LineageExplorer';
import { dataset, sourceById } from '../data/dataset';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/format';
import { buildHomepageHierarchy, firstHomepageRelease } from '../lib/homepage';
import { buildHomepageSearchIndex } from '../lib/homepage-search';
import { buildLineageEcosystems } from '../lib/lineage-view';
import { organizationLabel } from '../lib/organization-name';
import { buildCoverageStats, buildReleasePulse, latestChangeLabel } from '../lib/release-pulse';
import { buildReleaseSourceIndex } from '../lib/release-source';
import { absoluteUrl } from '../lib/seo';
import { buildDatasetJsonLd, buildWebsiteJsonLd } from '../lib/structured-data';

const hierarchy = buildHomepageHierarchy(dataset);
const homeSearchIndex = buildHomepageSearchIndex(dataset, import.meta.env.BASE_URL);
const ecosystems = buildLineageEcosystems(dataset);
const releaseLabels = Object.fromEntries(
	dataset.releases.map((release) => [release.id, release.displayName]),
);
const sourceByReleaseId = buildReleaseSourceIndex(dataset.releases, sourceById);
const latestVerification = [...dataset.releases.map(({ verifiedAt }) => verifiedAt)].sort().at(-1)!;
const base = import.meta.env.BASE_URL;
const passportHref = `${base}models/${firstHomepageRelease(hierarchy).slug}/`;

// Release Pulse and coverage are derived at build time. `now` is the build day;
// the window is counted back from it, so a build with only stale records shows an
// honest stale state rather than dressing an old change up as recent.
const pulseNow = new Date().toISOString().slice(0, 10);
const pulse = buildReleasePulse(dataset, { base, now: pulseNow });
const coverage = buildCoverageStats(dataset);
const latestChange = latestChangeLabel(pulse, dataset);

const homeDescription =
	'Explore who created AI models, how families fit together, when releases arrived, and which primary sources support each fact.';
const homeUrl = absoluteUrl(Astro.site?.origin ?? '', base);
const structuredData = [
	buildWebsiteJsonLd({ url: homeUrl, description: homeDescription }),
	buildDatasetJsonLd({
		url: homeUrl,
		name: 'ModelTree',
		description:
			'A source-backed record of AI model creators, families, releases, and the primary sources behind each fact.',
	}),
];
---

<BaseLayout
	title="ModelTree | AI Model Lineage"
	description={homeDescription}
	passportHref={passportHref}
	verifiedAt={formatDate(latestVerification)}
	currentPage="explore"
	socialImageAlt="ModelTree — the source-backed family tree of AI model creators, families, and releases."
	structuredData={structuredData}
>
	<main id="main-content">
		<section class="hero-intro" aria-labelledby="page-title">
			<div class="hero-copy">
				<span class="eyebrow">AI model lineage, source by source</span>
				<h1 id="page-title">The living family tree of AI models.</h1>
				<p>See who built each model, which family it belongs to, when it arrived, and what the official record actually says.</p>
				<a class="primary-action hero-tree-action" href={`${base}tree/`}>Open the Model Tree</a>
			</div>
			<dl class="coverage-stats" aria-label="Current ModelTree seed coverage">
				<div><dt>Creators</dt><dd>{coverage.creators}</dd></div>
				<div><dt>Families</dt><dd>{dataset.families.length}</dd></div>
				<div><dt>Releases</dt><dd>{dataset.releases.length}</dd></div>
				<div><dt>Sources</dt><dd>{dataset.sources.length}</dd></div>
			</dl>
		</section>

		<section class="home-search-band">
			<HomepageSearch client:load index={homeSearchIndex} />
			<noscript>
				<div class="no-script-note">
					<p>Search needs JavaScript. Every release has a static Model Passport:</p>
					<ul>
						{homeSearchIndex.releases.map((release) => (
							<li>
								<a href={release.route}>{release.name}</a> — {release.organizationName} · {release.familyName}
							</li>
						))}
					</ul>
				</div>
			</noscript>
		</section>

		<section id="explorer" class="explorer-band">
			<LineageExplorer
				client:load
				ecosystems={ecosystems}
				sourceByReleaseId={sourceByReleaseId}
				releaseLabels={releaseLabels}
				basePath={base}
			/>
			<noscript>
				<div class="no-script-note">
					<p>Every release has a static Model Passport:</p>
					{hierarchy.map(({ organization, families }) => (
						<section>
							<h3>{organizationLabel(organization)}</h3>
							{families.map(({ family, releases }) => (
								<div>
									<h4>{family.name}</h4>
									<ul>
										{releases.map((release) => <li><a href={`${base}models/${release.slug}/`}>{release.displayName}</a></li>)}
									</ul>
								</div>
							))}
						</section>
					))}
				</div>
			</noscript>
		</section>

		<section class="release-pulse" aria-labelledby="release-pulse-title">
			<div class="release-pulse-head">
				<span class="eyebrow">Release pulse</span>
				<h2 id="release-pulse-title">Recent verified changes</h2>
				<p class="release-pulse-lede">
					Source-dated lifecycle changes from the last {pulse.windowMonths} months, newest
					first, at most {pulse.maxItems}. Dated by what the record says happened, not by when
					we last re-checked it.
				</p>
			</div>

			{pulse.items.length > 0 ? (
				<ol class="release-pulse-list" role="list">
					{pulse.items.map((item) => (
						<li class="release-pulse-item">
							<p class="release-pulse-meta">
								<span class="release-pulse-type">{item.typeLabel}</span>
								<time datetime={item.date}>{item.dateLabel}</time>
							</p>
							<p class="release-pulse-change">{item.note}</p>
							<p class="release-pulse-links">
								<a class="release-pulse-model" href={item.releaseRoute}>{item.releaseName}</a>
								<a class="release-pulse-source" href={item.source.url} rel="noreferrer">
									<span class="release-pulse-source-label">Source:</span> {item.source.title}
								</a>
							</p>
						</li>
					))}
				</ol>
			) : (
				<p class="release-pulse-empty">
					{pulse.isStale
						? `No verified release changes in the last ${pulse.windowMonths} months.${latestChange ? ` The most recent recorded change was ${latestChange}.` : ''}`
						: 'No dated release changes are recorded yet.'}
				</p>
			)}

			<p class="release-pulse-coverage">
				Tracking {coverage.releases} releases across {coverage.families} families from{' '}
				{coverage.creators} creators, each backed by primary sources ({coverage.sources} in
				all). A curated seed, not a complete census of the field.
			</p>
		</section>
	</main>
</BaseLayout>
