---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/archivo';
import BrandMark from '../components/BrandMark.astro';
import ThemePicker from '../components/ThemePicker.astro';
import { themeBootstrapScript } from '../lib/theme';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  passportHref: string;
  verifiedAt: string;
}

const { title, description, passportHref, verifiedAt } = Astro.props;
const base = import.meta.env.BASE_URL;
const iconHref = `${base}favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline set:html={themeBootstrapScript}></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={iconHref} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <BrandMark href={base} />
        <nav aria-label="Primary navigation">
          <a href={base}>Explore</a>
          <a href={passportHref}>Model Passport</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <p><strong>ModelTree</strong> separates model creators, families, releases, and sources.</p>
      <p>Seed data verified {verifiedAt}. Unknown facts stay unknown.</p>
      <ThemePicker />
    </footer>
  </body>
</html>