---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/archivo';
import BrandMark from '../components/BrandMark.astro';
import ThemePicker from '../components/ThemePicker.astro';
import {
  ariaCurrentFor,
  buildPrimaryNavigation,
  groupHoldsCurrentPage,
  type NavPageId,
} from '../lib/navigation';
import { themeBootstrapScript } from '../lib/theme-bootstrap';
import {
  absoluteUrl,
  ogCardHref,
  OG_CARD_HEIGHT,
  OG_CARD_TYPE,
  OG_CARD_WIDTH,
  SITE_NAME,
} from '../lib/seo';
import type { JsonLd } from '../lib/structured-data';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  passportHref: string;
  verifiedAt: string;
  currentPage?: NavPageId;
  /**
   * The accessible text for the social card, and the per-page differentiator the
   * single shared card image cannot carry itself. It must name the specific
   * entity or page rather than repeat a site-wide string, so every route supplies
   * its own -- the prop is required for exactly that reason.
   */
  socialImageAlt: string;
  /**
   * A route that is not its own canonical -- a filtered or paginated view that
   * should point at the one indexable version of itself. Defaults to this page's
   * own path.
   */
  canonicalPath?: string;
  /** Robots directive. Defaults to indexing; a non-canonical view passes `noindex,follow`. */
  robots?: string;
  /** schema.org objects serialized into the head, in order. */
  structuredData?: JsonLd[];
}

const {
  title,
  description,
  passportHref,
  verifiedAt,
  currentPage,
  socialImageAlt,
  canonicalPath,
  robots = 'index,follow',
  structuredData = [],
} = Astro.props;
const base = import.meta.env.BASE_URL;
const iconHref = `${base}favicon.svg`;
const maskIconHref = `${base}mask-icon.svg`;
const refreshHref = `${base}refresh/`;
const navigation = buildPrimaryNavigation({ base, passportHref });

// Canonical, Open Graph, and the sitemap are generated at build (ADR 0001) and
// need an absolute origin. `astro.config.mjs` defaults `site` to the production
// origin when SITE_URL is unset, so `Astro.site` is always defined here.
const origin = Astro.site?.origin ?? '';
const canonicalURL = absoluteUrl(origin, canonicalPath ?? Astro.url.pathname);
const ogImageURL = absoluteUrl(origin, ogCardHref(base));
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline set:html={themeBootstrapScript}></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robots} />
    {/* Open Graph and Twitter. The card image is one shared branded raster; the
        per-page text a human actually reads is the title, description, and the
        image's alt, so those carry the differentiation. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content={OG_CARD_TYPE} />
    <meta property="og:image:width" content={String(OG_CARD_WIDTH)} />
    <meta property="og:image:height" content={String(OG_CARD_HEIGHT)} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" type="image/svg+xml" href={iconHref} />
    {/* Safari pinned tabs ignore the SVG favicon and want a monochrome
        silhouette they can recolour themselves. */}
    <link rel="mask-icon" href={maskIconHref} color="#0e1417" />
    {/* Paints the browser chrome to match the page ground rather than leaving a
        white bar above a dark page. Both are declared so the chrome follows the
        system scheme; the in-page theme is a separate, user-set choice. */}
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#f4f6f7"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0e1417"
    />
    <title>{title}</title>
    {structuredData.map((entry) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <BrandMark href={base} />
        <nav aria-label="Primary navigation" class="primary-nav" data-primary-nav>
          <ul class="nav-row">
            {navigation.map((item) => (
              <li class="nav-item">
                {item.kind === 'destination' ? (
                  <a href={item.href} aria-current={ariaCurrentFor(item, currentPage)}>
                    {item.label}
                  </a>
                ) : (
                  <details class="nav-disclosure" data-nav-disclosure>
                    <summary
                      class="nav-trigger"
                      data-nav-trigger
                      data-holds-current={groupHoldsCurrentPage(item, currentPage) ? 'true' : undefined}
                    >
                      {item.label}
                    </summary>
                    <ul class="nav-submenu" aria-label={item.label} id={item.id}>
                      {item.items.map((child) => (
                        <li>
                          <a href={child.href} aria-current={ariaCurrentFor(child, currentPage)}>
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <p><strong>ModelTree</strong> separates model creators, families, releases, and sources.</p>
      <p>Seed data verified {verifiedAt}. Unknown facts stay unknown. Every check is recorded under <a href={refreshHref}>Data refresh</a>.</p>
      <ThemePicker />
    </footer>
    <script>
      import { enhancePrimaryNavigation } from '../lib/nav-menu';

      const nav = document.querySelector<HTMLElement>('[data-primary-nav]');

      if (nav) enhancePrimaryNavigation(nav);
    </script>
  </body>
</html>