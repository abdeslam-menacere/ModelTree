---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/archivo';
import BrandMark from '../components/BrandMark.astro';
import ThemePicker from '../components/ThemePicker.astro';
import { themeBootstrapScript } from '../lib/theme-bootstrap';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  passportHref: string;
  verifiedAt: string;
  currentPage?: 'explore' | 'tree' | 'catalog' | 'directory' | 'timeline' | 'compare' | 'passport' | 'refresh' | 'methodology' | 'glossary';
}

const { title, description, passportHref, verifiedAt, currentPage } = Astro.props;
const base = import.meta.env.BASE_URL;
const iconHref = `${base}favicon.svg`;
const treeHref = `${base}tree/`;
const catalogHref = `${base}models/`;
const directoryHref = `${base}providers/`;
const timelineHref = `${base}timeline/`;
const compareHref = `${base}compare/`;
const refreshHref = `${base}refresh/`;
const methodologyHref = `${base}methodology/`;
const glossaryHref = `${base}glossary/`;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline set:html={themeBootstrapScript}></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={iconHref} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <BrandMark href={base} />
        <nav aria-label="Primary navigation">
          <a href={base} aria-current={currentPage === 'explore' ? 'page' : undefined}>Explore</a>
          <a href={treeHref} aria-current={currentPage === 'tree' ? 'page' : undefined}>Model Tree</a>
          <a href={catalogHref} aria-current={currentPage === 'catalog' ? 'page' : undefined}>Catalog</a>
          <a href={directoryHref} aria-current={currentPage === 'directory' ? 'page' : undefined}>Directory</a>
          <a href={timelineHref} aria-current={currentPage === 'timeline' ? 'page' : undefined}>Timeline</a>
          <a href={compareHref} aria-current={currentPage === 'compare' ? 'page' : undefined}>Compare</a>
          <a href={passportHref} aria-current={currentPage === 'passport' ? 'page' : undefined}>Model Passport</a>
          <a href={refreshHref} aria-current={currentPage === 'refresh' ? 'page' : undefined}>Data refresh</a>
          <a href={methodologyHref} aria-current={currentPage === 'methodology' ? 'page' : undefined}>Methodology</a>
          <a href={glossaryHref} aria-current={currentPage === 'glossary' ? 'page' : undefined}>Explain this name</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <p><strong>ModelTree</strong> separates model creators, families, releases, and sources.</p>
      <p>Seed data verified {verifiedAt}. Unknown facts stay unknown. Every check is recorded under <a href={refreshHref}>Data refresh</a>.</p>
      <ThemePicker />
    </footer>
  </body>
</html>