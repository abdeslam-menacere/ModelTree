---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<!--
  The mark is inlined rather than loaded through `<img src="favicon.svg">`. An
  `<img>` is a separate document: it cannot see `html[data-theme]`, cannot read
  the token layer, and cannot respond to forced colours, so the header mark was
  previously pinned to one palette while the page around it changed theme.
  Inlining also removes a render-blocking request from every page.

  `favicon.svg` stays on disk as the standalone asset the browser needs for
  `<link rel="icon">`, where no document-level element is available.

  The mark carries no accessible name of its own. The anchor is already labelled
  "ModelTree home" and the wordmark beside it repeats that in text, so a named
  image here would make a screen reader announce the brand three times for one
  link. It is `aria-hidden`, and the text stays the accessible name.
-->
<a class="brand" href={href} aria-label="ModelTree home">
  <svg
    class="brand-mark"
    viewBox="0 0 64 64"
    width="34"
    height="34"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M13 50V17l19 20 19-20v33M32 37V18"
      fill="none"
      stroke="var(--cp-accent)"
      stroke-width="6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle cx="13" cy="17" r="5.5" fill="var(--cp-text)" />
    <circle cx="32" cy="15" r="5.5" fill="var(--cp-text)" />
    <circle cx="51" cy="17" r="5.5" fill="var(--cp-text)" />
  </svg>
  <span class="brand-copy">
    <strong>ModelTree</strong>
    <small>AI Model Lineage</small>
  </span>
</a>